# Environment Variables
NODE_ENV=development
PORT=8000

# Database
DATABASE_URL=mysql://app:app@localhost:3306/appdb

# Logging
LOG_LEVEL=info
# Disable Prisma console logging (queries will be logged to files)
PRISMA_DISABLE_CONSOLE_LOG=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Security
CORS_ORIGIN=http://localhost:3000

# Google Programmable Search Engine API
# Get your API key from: https://console.cloud.google.com/
# Get your Search Engine ID from: https://cse.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Apollo.io API Configuration
# Get your API key from: https://app.apollo.io/
# Required for organization enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/
# Required for ChatGPT integration and data enrichment
OPENAI_API_KEY=your-openai-api-key-here

# Authentication Configuration
# JWT secret key for token signing (use a strong random string)
JWT_SECRET=your-very-strong-secret-key-here
JWT_EXPIRES_IN=24h

# Admin User Credentials (for single-user system)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here